{
    "manifest_version": 3, 
    "name": "Paste-Guard",
    "version": "0.1",
    "description": "Warns before user paste sensitive info",
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle"

        }

    ]

}